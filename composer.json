{
  "name": "effina/larabanner",
  "description": "A simple banner management system for Laravel",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "effina",
      "email": "tech@effina.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/view": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "effina\\Larabanner\\": "src/",
      "effina\\Larabanner\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "effina\\Larabanner\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "effina\\Larabanner\\LarabannerServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
